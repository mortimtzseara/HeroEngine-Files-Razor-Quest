@page
@model HeroEngine.Web.Pages.Heroes.IndexModel
@{
    ViewData["Title"] = "Heroes List";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>List of Heroes</h1>
    <a asp-page="/Heroes/Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> New Hero
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Class</th>
                    <th class="text-center">Level</th>
                    <th class="text-center">HP</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var hero in Model.Heroes)
                {
                    <tr>
                        <td><strong>@hero.Name</strong></td>
                        <td>
                            <span class="badge bg-info text-dark">@hero.GetType().Name</span>
                        </td>
                        <td class="text-center">@hero.Level</td>
                        <td class="text-center">
                            <div class="progress" style="height: 20px;">
                                <div class="progress-bar bg-danger" role="progressbar" style="width: 100%">
                                    @hero.CurrentHP / @hero.MaxHP
                                </div>
                            </div>
                        </td>
                        <td class="text-end">
                            <a asp-page="/Heroes/Detail" asp-route-name="@hero.Name" class="btn btn-sm btn-outline-primary">
                                Ver Detalles
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-4">
    <a asp-page="/Index" class="btn btn-link">Volver al inicio</a>
</div>