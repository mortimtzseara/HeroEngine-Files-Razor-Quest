@page "{name}" 
@model HeroEngine.Web.Pages.Heroes.DetailModel
@using HeroEngine.Core.Models.Combatants.Heroes

@{
    ViewData["Title"] = Model.Hero != null ? "Details of " + Model.Hero.Name : "Hero Not Found";
}

@if (Model.Hero != null)
{
    <div class="card shadow">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h2 class="mb-0">Hero Profile: @Model.Hero.Name</h2>
            <span class="badge bg-light text-dark fs-6">Class: @Model.Hero.GetType().Name</span>
        </div>
        
        <div class="card-body">
            @if (Model.Hero is Mage mageHero)
            {
                <hr />
                <div class="mt-4">
                    <h4>Spellbook</h4>
                </div>
            }
        </div>
        
        <div class="card-footer text-center">
            <a asp-page="/Heroes/Index" class="btn btn-secondary">Back to Tavern</a>
        </div>
    </div>
}
else
{
    <div class="alert alert-danger">
        Hero not found. <a asp-page="/Heroes/Index">Return to list.</a>
    </div>
}