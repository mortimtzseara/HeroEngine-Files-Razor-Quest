@page
@model HeroEngine.Web.Pages.Heroes.CreateModel
@{
    ViewData["Title"] = "Add New Hero";
}

<h1>Add New Hero</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form method="post">
            
            <div class="mb-3">
                <label asp-for="Input.Name" class="form-label">Nombre del Héroe</label>
                <input asp-for="Input.Name" class="form-control" placeholder="Ej: Gandalf" />
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.HeroClass" class="form-label">Class</label>
                <select asp-for="Input.HeroClass" class="form-select">
                    <option value="">-- Select a class --</option>
                    <option value="Warrior">Warrior</option>
                    <option value="Mage">Mage</option>
                    <option value="Rogue">Rogue</option>
                </select>
                <span asp-validation-for="Input.HeroClass" class="text-danger"></span>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-success">Create Hero</button>
                <a asp-page="/Heroes/Index" class="btn btn-secondary">Cancel</a>
            </div>
            
        </form>
    </div>
</div>