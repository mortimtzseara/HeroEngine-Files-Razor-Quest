@page
@model HeroEngine.Web.Pages.StatsModel
@{
    ViewData["Title"] = "Hero Analytics";
}

<div class="container mt-4">
    <h2 class="text-center mb-4">📊 Tavern Analytics</h2>

    <div class="row">
        <div class="col-md-12 mb-4">
            <div class="card shadow-sm border-primary">
                <div class="card-body">
                    <h5 class="card-title">Advanced Hero Search (Regex)</h5>
                    <form method="get" class="d-flex gap-2">
                        <input asp-for="SearchPattern" class="form-control" placeholder="Example: ^A.* (Starts with A)...">
                        <button type="submit" class="btn btn-primary">Search</button>
                    </form>
                    
                    @if (Model.FilteredHeroes != null && Model.FilteredHeroes.Any())
                    {
                        <ul class="list-group mt-3">
                            @foreach (var hero in Model.FilteredHeroes)
                            {
                                <li class="list-group-item">🎯 <strong>@hero.Name</strong> (@hero.GetType().Name)</li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm border-warning">
                <div class="card-header bg-warning text-dark fw-bold">🏆 Top 3 High Level Heroes</div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        @foreach (var hero in Model.TopHeroes)
                        {
                            <li class="list-group-item d-flex justify-content-between">
                                <span>@hero.Name</span>
                                <span class="badge bg-dark">Lvl @hero.Level</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm border-info">
                <div class="card-header bg-info text-white fw-bold">👥 Hero Distribution</div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        @foreach (var entry in Model.ClassDistribution)
                        {
                            <li class="list-group-item d-flex justify-content-between">
                                <span>@entry.Key</span>
                                <span class="badge bg-secondary">@entry.Value heroes</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">📜 Battle History</h5>
            <form method="get" class="d-flex align-items-center">
                <select asp-for="OutcomeFilter" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Results</option>
                    <option value="VICTORY">Victories</option>
                    <option value="DEFEAT">Defeats</option>
                </select>
            </form>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Outcome</th>
                        <th>MVP</th>
                        <th>Damage</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.RecentCombats)
                    {
                        <tr>
                            <td>@c.Date</td>
                            <td>
                                <span class="badge @(c.Outcome.Contains("VICTORY") ? "bg-success" : "bg-danger")">
                                    @c.Outcome
                                </span>
                            </td>
                            <td>@c.MostEffective</td>
                            <td>@c.TotalDamage</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card shadow-sm mb-5">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">Average Potential Damage per Class</h5>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Class</th>
                        <th>Average Total Damage</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model.AverageDamageDistribution)
                    {
                        <tr>
                            <td><strong>@entry.Key</strong></td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <span class="me-3 fw-bold">@entry.Value.ToString("F2")</span>
                                    <div class="progress flex-grow-1" style="height: 12px;">
                                        <div class="progress-bar bg-danger" role="progressbar"
                                             style="width: @(Math.Min(entry.Value, 100))%"></div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>