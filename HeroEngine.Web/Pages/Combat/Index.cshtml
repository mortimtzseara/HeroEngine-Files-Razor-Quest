@page
@model HeroEngine.Web.Pages.Combat.IndexModel
@{
    ViewData["Title"] = "Combat Arena";
}

<div class="container mt-4">
    <h2 class="text-center mb-4">⚔️ Combat Arena</h2>

    <form method="post" class="card shadow-sm border-danger">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">Battle Setup</h4>
        </div>
        
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 border-end">
                    <h4 class="text-primary"><i class="bi bi-shield-shaded"></i> Your Party</h4>
                    <p class="text-muted small">All heroes in the tavern will join the fight:</p>
                    <ul class="list-group list-group-flush">
                        @foreach (var hero in Model.AvailableHeroes)
                        {
                            <li class="list-group-item">
                                <strong>@hero.Name</strong>
                                <span class="badge bg-info text-dark">@hero.GetType().Name</span>
                                <span class="badge bg-secondary">Lvl @hero.Level</span>
                            </li>
                        }
                    </ul>
                    @if (!Model.AvailableHeroes.Any())
                    {
                        <div class="alert alert-warning">No heroes found in the tavern!</div>
                    }
                </div>

                <div class="col-md-6">
                    <h4 class="text-danger"><i class="bi bi-bug-fill"></i> Enemy Horde</h4>
                    <p class="text-muted small">Configure the size of the enemy wave:</p>
                    
                    <div class="row g-3">
                        <div class="col-4">
                            <label class="form-label fw-bold">Minions</label>
                            <input asp-for="MinionCount" type="number" class="form-control" min="0" max="10">
                        </div>
                        <div class="col-4">
                            <label class="form-label fw-bold">Elites</label>
                            <input asp-for="EliteCount" type="number" class="form-control" min="0" max="5">
                        </div>
                        <div class="col-4">
                            <label class="form-label fw-bold">Bosses</label>
                            <input asp-for="BossCount" type="number" class="form-control" min="0" max="2">
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="card-footer bg-transparent p-3">
            <button type="submit" class="btn btn-danger btn-lg w-100 shadow">
                <i class="bi bi-swords"></i> START WAR
            </button>
        </div>
    </form>

    @if (!string.IsNullOrEmpty(Model.LastCombatLog))
    {
        <div class="mt-5 mb-5">
            <h3 class="text-danger border-bottom pb-2">
                <i class="bi bi-journal-text"></i> Last Battle Chronicles
            </h3>
            <div class="card bg-dark shadow-lg">
                <div class="card-body p-0">
                    <pre class="m-0 p-4" style="white-space: pre-wrap; font-family: 'Consolas', 'Monaco', monospace; color: #00ff00; background-color: #1a1a1a; max-height: 500px; overflow-y: auto;">@Model.LastCombatLog</pre>
                </div>
            </div>
        </div>
    }
</div>